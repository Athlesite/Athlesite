# Copy this file to .env.local and fill in real values from your Supabase
# project settings (Project Settings > API). Never commit .env.local —
# it's already covered by the .env* pattern in .gitignore.

# Project URL (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable/anon key (Project Settings > API > Project API keys).
# Safe to expose to the browser — this key's access is bounded entirely by
# the RLS policies in supabase/migrations/, not by keeping it secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Intentionally no service-role key — this project is designed to run
# entirely through authenticated user clients + RLS. Do not add one without
# a deliberate, specific reason.
